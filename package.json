    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
