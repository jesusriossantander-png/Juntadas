# Copiá este archivo como .env.local y completá con los datos PÚBLICOS de tu proyecto Supabase.
# Nunca pongas la service_role key en el frontend.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
# Clave pública VAPID para Web Push (la privada va SOLO en los secretos de la Edge Function).
VITE_VAPID_PUBLIC_KEY=
# URL pública donde queda publicada la app (para enlaces de invitación y WhatsApp). Opcional.
VITE_PUBLIC_APP_URL=
